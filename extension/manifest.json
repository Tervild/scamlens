{
	"manifest_version": 3,
	"name": "ScamLens",
	"version": "1.0",
	"permissions": ["activeTab", "storage"],
	"host_permissions": ["<all_urls>"],
	"action": {
		"default_popup": "popup.html"
	},
	"content_scripts": [
		{
			"matches": ["<all_urls>"],
			"js": ["content.js"],
			"css": ["styles.css"]
		}
	]
}
